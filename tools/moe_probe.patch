+// temporary diagnostic: GPU MoE cache slot result vs CPU result on the same host weights
+static bool moe_probe_enabled(void) {
+    static const bool on = getenv("LLAMA_MOE_PROBE") != nullptr;
+    return on;
+}
+
+void llama_graph_moe_probe_print(ggml_cgraph * gf, int n_tokens) {
+    if (!moe_probe_enabled() || gf == nullptr) {
+        return;
+    }
+
+    std::map<int, ggml_tensor *> gpu, cpu, ids;
+
+    for (int i = 0; i < ggml_graph_n_nodes(gf); i++) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        const char * name = ggml_get_name(node);
+        int il = -1;
+        if (sscanf(name, "moe_probe_gpu_%d", &il) == 1) {
+            gpu[il] = node->src[1]; // the cpy destination, on the CPU
+        } else if (sscanf(name, "moe_probe_cpu_%d", &il) == 1) {
+            cpu[il] = node;
+        } else if (sscanf(name, "moe_probe_ids_%d", &il) == 1) {
+            ids[il] = node;
+        }
+    }
+
+    LLAMA_LOG_INFO("%s: scanning %d nodes, gpu=%zu cpu=%zu ids=%zu\n",
+            __func__, ggml_graph_n_nodes(gf), gpu.size(), cpu.size(), ids.size());
+
+    for (auto & kv : gpu) {
+        const int il = kv.first;
+        if (cpu.find(il) == cpu.end() || ids.find(il) == ids.end()) {
+            continue;
+        }
+
+        ggml_tensor * g = kv.second;
+        ggml_tensor * c = cpu[il];
+        ggml_tensor * m = ids[il];
+
+        const int n_used = (int) c->ne[1];
+        const int n_tok  = std::min((int) c->ne[2], n_tokens);
+        const int ne0    = (int) c->ne[0];
+
+        double max_abs = 0.0, max_rel = 0.0, max_g = 0.0, max_c = 0.0, sum_abs = 0.0;
+        long n_big = 0;
+        long n_cmp = 0;
+
+        for (int t = 0; t < n_tok; t++) {
+            for (int s = 0; s < n_used; s++) {
+                if (((const int32_t *) m->data)[t*n_used + s] != -1) {
+                    continue; // not resident: the CPU computed it, the GPU read the zero slot
+                }
+                const float * pg = (const float *) ((char *) g->data + s*g->nb[1] + t*g->nb[2]);
+                const float * pc = (const float *) ((char *) c->data + s*c->nb[1] + t*c->nb[2]);
+                for (int i = 0; i < ne0; i++) {
+                    const double d = fabs(pg[i] - pc[i]);
+                    const double v = fabs(pc[i]);
+                    if (d > max_abs) max_abs = d;
+                    if (v > 1e-3 && d/v > max_rel) max_rel = d/v;
+                    if (fabs(pg[i]) > max_g) max_g = fabs(pg[i]);
+                    if (v > max_c) max_c = v;
+                    sum_abs += d;
+                    if (d > 1e-4) n_big++;
+                    n_cmp++;
+                }
+            }
+        }
+
+        LLAMA_LOG_INFO("%s: layer %d rows %ld, max abs = %.6f, mean abs = %.6f, big %ld, max rel = %.8f, max gpu = %.6f, max cpu = %.6f\n",
+                __func__, il, n_cmp, max_abs, n_cmp ? sum_abs/n_cmp : 0.0, n_big, max_rel, max_g, max_c);
+
+        if (n_cmp > 0 && n_cmp < 8192) {
+            const float * pg0 = (const float *) ((char *) g->data + 0*g->nb[1]);
+            const float * pc0 = (const float *) ((char *) c->data + 0*c->nb[1]);
+            LLAMA_LOG_INFO("%s: layer %d g=%p c=%p ne[%ld,%ld,%ld] nb[%ld,%ld] gpu0=[%.6f %.6f %.6f %.6f] cpu0=[%.6f %.6f %.6f %.6f]\n",
+                    __func__, il, (void *) g->data, (void *) c->data,
+                    (long) c->ne[0], (long) c->ne[1], (long) c->ne[2], (long) c->nb[1], (long) c->nb[2],
+                    pg0[0], pg0[1], pg0[2], pg0[3], pc0[0], pc0[1], pc0[2], pc0[3]);
+        }
+    }
+}
